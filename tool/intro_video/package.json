{
  "name": "privacy-lens-intro-video",
  "private": true,
  "description": "Dev-only Remotion source for the onboarding intro. Never shipped, never run by the app.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:light": "remotion render src/index.ts Intro-light ../../assets/video/intro_light.mp4 --codec=h264 --crf=20 --muted --pixel-format=yuv420p",
    "render:dark": "remotion render src/index.ts Intro-dark ../../assets/video/intro_dark.mp4 --codec=h264 --crf=20 --muted --pixel-format=yuv420p",
    "render": "npm run render:light && npm run render:dark"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
